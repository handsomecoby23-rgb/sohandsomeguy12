    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch index.html (로컬 파일 직접 실행)",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost (서버가 켜져 있을 때)",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}